# 选填你要使用的 provider key，至少填一个
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# 可选：自定义模型（默认值如下）
# Anthropic:   claude-sonnet-4-6
# OpenAI:      gpt-4o
# Gemini:      gemini/gemini-2.0-flash
# Ollama:      ollama/llama3  (本地，无需 key)
# OpenRouter:  openrouter/anthropic/claude-3.5-sonnet
MAIN_MODEL=claude-sonnet-4-6
BRANCH_MODEL=claude-haiku-4-5-20251001
