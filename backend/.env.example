# ── Provider API Keys (fill in whichever you use) ──────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=           # Google Gemini
OPENROUTER_API_KEY=       # openrouter.ai — gateway to many providers

# ── Default Models (LiteLLM model string format) ────────────────────────────
# Anthropic:   claude-sonnet-4-6 / claude-haiku-4-5-20251001 / claude-opus-4-7
# OpenAI:      gpt-4o / gpt-4o-mini / o3-mini
# Gemini:      gemini/gemini-2.0-flash / gemini/gemini-2.5-pro
# Ollama:      ollama/llama3  (no key needed, must run Ollama locally)
# OpenRouter:  openrouter/anthropic/claude-3.5-sonnet
MAIN_MODEL=claude-sonnet-4-6
BRANCH_MODEL=claude-haiku-4-5-20251001

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./tracechat.db
